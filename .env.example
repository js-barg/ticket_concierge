NODE_ENV=development

# Local Postgres via docker-compose
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ticket_concierge

# Port for Next.js dev (Cloud Run will inject PORT in production)
PORT=3000

# NextAuth (admin); set NEXTAUTH_SECRET in production (e.g. from Secret Manager)
NEXTAUTH_SECRET=your-secret-at-least-32-chars-long
NEXTAUTH_URL=http://localhost:3000

# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
APP_BASE_URL=http://localhost:3000

