# =============================================================================
# Local development — copy to .env and fill in. Never commit .env.
# For production, set variables in Cloud Run / Secret Manager; see README.
# =============================================================================

NODE_ENV=development

# Local Postgres (use host "db" when using docker-compose, "localhost" when DB is on host)
DATABASE_URL=postgres://postgres:postgres@db:5432/ticket_concierge

PORT=3000

# NextAuth (admin)
NEXTAUTH_SECRET=your-secret-at-least-32-chars-long
NEXTAUTH_URL=http://localhost:3000

# Stripe (test mode for local)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
APP_BASE_URL=http://localhost:3000

# Optional: email (stub logs to console if unset)
# FROM_EMAIL=
# RESEND_API_KEY=

