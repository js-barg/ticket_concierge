generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Phase 1 foundation only: we define the core models but do not
// yet implement any business logic, flows, or APIs that use them.

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  role      UserRole
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  ADMIN
  FULFILLMENT
  FINANCE
}

