# Production environment variables (Cloud Run / Cloud SQL).
# Do NOT commit real values. Set these in Cloud Run service env vars or Secret Manager.
# Use this file as a checklist for production configuration.

NODE_ENV=production

# Cloud Run sets this automatically; document for local container runs.
PORT=3000

# Public URL of the app (e.g. https://ticket-concierge-web-xxxx.run.app)
APP_BASE_URL=https://your-service.run.app
NEXTAUTH_URL=https://your-service.run.app

# Cloud SQL: use the connection name or private IP URL from Cloud SQL.
# For migrations, use a direct connection; for app, pooling URL is fine if you use a pooler.
DATABASE_URL=postgresql://user:password@/ticket_concierge?host=/cloudsql/PROJECT:REGION:INSTANCE
# Optional: direct URL for Prisma migrations (e.g. when not using Unix socket).
# DIRECT_DATABASE_URL=postgresql://user:password@PRIVATE_IP:5432/ticket_concierge

# Session secret (min 32 chars). Prefer Secret Manager.
NEXTAUTH_SECRET=your-production-secret-min-32-chars

# Stripe (live keys in production)
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx

# Email (when provider is configured)
FROM_EMAIL=noreply@yourdomain.com
# RESEND_API_KEY=re_xxx  # or other provider

# Optional: storage (for future GCS adapter)
# GCS_PUBLIC_BUCKET=ticket-concierge-public-assets
# GCS_PRIVATE_BUCKET=ticket-concierge-private-attachments
# GOOGLE_CLOUD_PROJECT=your-project-id
